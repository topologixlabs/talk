{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talk",
  "version": "0.1.0",
  "identifier": "com.topologixlabs.talk.localtest",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Talk (local test)", "theme": "Dark", "width": 1240, "height": 800, "minWidth": 980, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
